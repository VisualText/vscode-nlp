node_modules/

# Build output. dist/ is webpack's (the shipped bundle); out/ is tsc's, kept
# separate so `npm run compile` cannot litter the directory the vsix is built
# from. Both are regenerated by `npm run package`, so neither belongs in git.
dist/
out/
out-format/
out-language/
out-treeview/
*.vsix

# Per-workspace VisualText state written at run time, not project configuration
.vscode/state.json
