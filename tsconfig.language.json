// Standalone build for the pure-TS language-intelligence engines + test harness.
// Mirrors tsconfig.format.json: emits to out-language/ (gitignored, not shipped)
// and excludes the one remaining VSCode adapter (engineDiagnostics) so the pure
// analysis logic can be exercised with plain Node. Run via:
//   npm run test:language
//
// src/server is included: the language server imports no 'vscode', so building
// it here is what proves that stays true -- a stray import fails this build
// rather than shipping a server that cannot start.
{
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "out-language",
		"module": "node16",
		"moduleResolution": "node16",
		"target": "es2019",
		"lib": ["es2019"],
		"strict": true,
		"noImplicitAny": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"],
		"sourceMap": false
	},
	"include": ["src/language/**/*.ts", "src/format/**/*.ts", "src/server/**/*.ts"],
	"exclude": [
		"src/language/engineDiagnostics.ts",
		"src/format/corpusTest.ts"
	]
}
