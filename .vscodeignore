# Source files - bundled by webpack
src/**
tsconfig.json
webpack.config.js

# Build/CI helpers - never shipped
scripts/**

# Grammar submodule (VisualText/nlpplus-tmbundle): ship syntaxes/ only, not the
# bundle's own docs, samples, packaging files or git metadata
grammars/README.md
grammars/language-configuration/**
grammars/LICENSE
grammars/package.json
grammars/samples/**
grammars/.git*

# Standalone Cloudflare telemetry worker (deployed separately, never shipped)
telemetry-worker/**

# Formatter test-harness build output (npm run test:format) - never shipped
out-format/**

# Webpack output: ship the bundle only. `tsc` (npm run compile) also emits per-module
# .js/.js.map here, and without this every one of them would be packaged - dead code,
# since package.json main points at dist/extension.js. Re-included below.
dist/**

# Build artifacts we don't need
*.vsix
.vscode/**
# ...but ship the colorization template: colorizeAnalyzer() copies it into each workspace's .vscode/settings.json
!.vscode/settings.json
.claude/**

# Node modules - bundled by webpack
node_modules/**

# Development files
.git*
.eslintrc.json
npm-debug.log*
*.log
.nyc_output
coverage

# Test files
test/**
*.test.ts
*.test.js

# Keep only what's needed for the extension
!dist/extension.js
!dist/extension.js.map
!dist/extension.js.LICENSE.txt
!resources/**
!snippets/**
!grammars/syntaxes/**
!themes/**
!*.md
!*.html
!*-configuration.json
!.vscodeignore
!package.json
!LICENSE*