# Source files - bundled by webpack
src/**
tsconfig.json
webpack.config.js

# Standalone tsc projects behind the test harnesses. Their build output is not
# gitignored-by-accident cruft: whether it exists depends on whether anyone ran
# `npm run test:*` before packaging, so without these the vsix contents differ
# between a clean checkout and a developer machine.
tsconfig.format.json
tsconfig.language.json
tsconfig.treeview.json
tsconfig.test.json

# VSCode proposed-API typings: a build-time .d.ts, never loaded at runtime
vscode.proposed.d.ts

# Build/CI helpers - never shipped
scripts/**

# Grammar submodule (VisualText/nlpplus-tmbundle): ship syntaxes/ only, not the
# bundle's own docs, samples, packaging files or git metadata
grammars/README.md
grammars/language-configuration/**
grammars/LICENSE
grammars/package.json
grammars/samples/**
grammars/.git*

# Standalone Cloudflare telemetry worker (deployed separately, never shipped)
telemetry-worker/**

# Test-harness build output (npm run test:format / test:language / test:treeview)
# - never shipped
out-format/**
out-language/**
out-treeview/**
out-test/**

# VS Code builds downloaded by the integration harness - large and never shipped
.vscode-test/**

# tsc output (npm run compile / watch). Only the webpack bundle ships; this is
# here purely so a developer who ran `tsc` does not change what gets packaged.
out/**

# Webpack output: ship the bundle only, never any stale sibling a build left behind.
# package.json main points at dist/extension.js; the re-includes are at the bottom.
dist/**

# Build artifacts we don't need
*.vsix
.vscode/**
# ...but ship the colorization template: colorizeAnalyzer() copies it into each workspace's .vscode/settings.json
!.vscode/settings.json
.claude/**

# Node modules - bundled by webpack
node_modules/**

# Development files
.git*
.github/**
.eslintrc.json
eslint.config.js
npm-debug.log*
*.log
.nyc_output
coverage

# Test files
test/**
*.test.ts
*.test.js

# Keep only what's needed for the extension
!dist/extension.js
!dist/extension.js.map
!dist/extension.js.LICENSE.txt
!resources/**
!snippets/**
!grammars/syntaxes/**
!themes/**
!*.md
!*.html
!*-configuration.json
!.vscodeignore
!package.json
!LICENSE*