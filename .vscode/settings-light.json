            },
            {
                "scope": "variable.parameter.txxt",
                "settings": {
                    "foreground": "#000000"
                }
            },
            {
                "scope": "entity.name.type.level2.kbb",
                "settings": {
                    "foreground": "#909228"
                }
            },
            {
                "scope": "entity.name.type.level1.kbb",
                "settings": {
                    "foreground": "#7e7e7e"
                }
            },
            {
                "scope": "entity.name.type.level2.kbb",
                "settings": {
                    "foreground": "#2eb657"
                }
            },
            {
                "scope": "entity.name.type.level3.kbb",
                "settings": {
                    "foreground": "#e049d9"
                }
            }
        ]
    },
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "git.ignoreLimitWarning": true
}