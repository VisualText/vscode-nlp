{
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "entity.name.function.letter.nlp",
                "settings": {
                    "foreground": "#dc1b1b"
                }
            },
            {
                "scope": [
                    "variable.parameter.nlp",
                    "keyword.control.kb"
                ],
                "settings": {
                    "foreground": "#696969"
                }
            },
            {
                "scope": "entity.other.attribute-name.nlp",
                "settings": {
                    "foreground": "#e655f3"
                }
            },
            {
                "scope": [
                    "constant.numeric.tree",
                    "constant.numeric.kbb"
                ],
                "settings": {
                    "foreground": "#5596f0"
                }
            },
            {
                "scope": "keyword.other.fired.tree",
                "settings": {
                    "foreground": "#dc1b1b"
                }
            },
            {
                "scope": "entity.name.type.tree",
                "settings": {
                    "foreground": "#000000"
                }
            },
            {
                "scope": "string.unquoted.token.tree",
                "settings": {
                    "foreground": "#4e8e3c"
